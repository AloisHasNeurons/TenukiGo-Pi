#!/usr/bin/env python3
"""Custom HTTP Server for TenukiGo-Pi Wi-Fi Configuration.

This script launches a simple HTTP server to allow users to configure
the Wi-Fi credentials of the Raspberry Pi when in Access Point mode.
It also implements a Captive Portal mechanism to redirect users to
the configuration page automatically.
"""

import http.server
import socketserver
import urllib.parse
import subprocess
import os
import uuid
from typing import List

# Server Configuration
PORT = 80
AP_GATEWAY_IP = "10.0.0.1"

# Paths configured by Ansible
VIDEO_DIR = "{{ videos_dir }}"
SGF_DIR = "{{ sgf_dir }}"
STREAM_CONFIG_FILE = os.path.join(VIDEO_DIR, "../stream_config.txt")

{% raw %}
class WifiConfigHandler(http.server.SimpleHTTPRequestHandler):
    """Handles HTTP requests for Wi-Fi configuration and file serving.
    
    Attributes:
        video_extensions: Tuple of allowed video file extensions.
        sgf_extensions: Tuple of allowed SGF file extensions.
        static_extensions: Tuple of allowed static file extensions.
    """
    
    video_extensions = ('.h264', '.mp4', '.mkv')
    sgf_extensions = ('.sgf',)
    static_extensions = ('.css', '.js', '.png', '.ico')

    def _get_video_list_html(self) -> str:
        """Generates the HTML list of video files found in VIDEO_DIR."""
        try:
            files = [f for f in os.listdir(VIDEO_DIR) if f.endswith(self.video_extensions)]
            if not files:
                return "<li>No video files found.</li>"
            return "".join([f'<li><a href="{f}">{f}</a></li>' for f in files])
        except FileNotFoundError:
            return "<li>Video directory not found.</li>"

    def _get_sgf_list_html(self) -> str:
        """Generates the HTML list of SGF files found in SGF_DIR."""
        try:
            files = [f for f in os.listdir(SGF_DIR) if f.endswith(self.sgf_extensions)]
            if not files:
                return "<li>No SGF files found.</li>"
            return "".join([f'<li><a href="/sgf/{f}">{f}</a></li>' for f in files])
        except FileNotFoundError:
            return "<li>SGF directory not found.</li>"

    def _get_current_stream_url(self) -> str:
        """Reads the current RTMP URL from the config file."""
        try:
            if os.path.exists(STREAM_CONFIG_FILE):
                with open(STREAM_CONFIG_FILE, 'r') as f:
                    return f.read().strip()
        except Exception:
            pass
        return "rtmp://172.20.10.3:1935/live/1"

    def do_GET(self) -> None:
        """Handles GET requests. 
        
        Serves the configuration page, static files, specific SGF files, 
        or redirects to the Captive Portal for all other requests.
        """
        if self.path == '/':
            self.send_response(200)
            self.send_header('Content-Type', 'text/html; charset=utf-8')
            self.end_headers()

            files_html = self._get_video_list_html()
            sgf_html = self._get_sgf_list_html()
            current_stream_url = self._get_current_stream_url()

            html_content = f"""
            <!DOCTYPE html>
            <html lang="en">
            <head>
                <meta charset="UTF-8">
                <meta name="viewport" content="width=device-width, initial-scale=1">
                <title>TenukiGo Configuration</title>
                <style>
                    body {{ font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; padding: 20px; max-width: 600px; margin: auto; color: #333; }}
                    h1 {{ margin-bottom: 20px; }}
                    h2 {{ border-bottom: 1px solid #ccc; padding-bottom: 10px; margin-top: 30px; }}
                    input {{ width: 100%; padding: 12px; margin: 8px 0; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box; }}
                    button {{ background-color: #007bff; color: white; padding: 14px 20px; border: none; border-radius: 4px; width: 100%; font-size: 16px; cursor: pointer; }}
                    button:hover {{ background-color: #0056b3; }}
                    .video-list {{ background-color: #f9f9f9; padding: 15px; border-radius: 8px; border: 1px solid #eee; }}
                    ul {{ padding-left: 20px; }}
                    li {{ margin-bottom: 5px; }}
                    a {{ text-decoration: none; color: #007bff; }}
                    a:hover {{ text-decoration: underline; }}
                </style>
            </head>
            <body>
                <h1>TenukiGo-Pi</h1>
                
                <div class="video-list">
                    <h2>Recorded Videos</h2>
                    <ul>{files_html}</ul>
                </div>

                <div class="video-list" style="margin-top: 20px;">
                    <h2>Generated SGFs</h2>
                    <ul>{sgf_html}</ul>
                </div>

                <div>
                    <h2>Streaming Setup</h2>
                    <form method="POST">
                        <input type="hidden" name="action" value="stream">
                        <label for="stream_url">RTMP URL</label>
                        <input type="text" id="stream_url" name="stream_url" value="{current_stream_url}" required>
                        <button type="submit">Update Stream URL</button>
                    </form>
                </div>

                <div>
                    <h2>Wi-Fi Setup</h2>
                    <form method="POST">
                        <input type="hidden" name="action" value="wifi">
                        <label for="ssid">Network Name (SSID)</label>
                        <input type="text" id="ssid" name="ssid" placeholder="e.g. MyHomeNetwork" required>
                        
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" placeholder="Network Security Key" required>
                        
                        <button type="submit">Save and Reboot</button>
                    </form>
                </div>
            </body>
            </html>
            """
            self.wfile.write(html_content.encode('utf-8'))

        elif self.path.startswith('/sgf/'):
            # Manually serve SGF file from the SGF_DIR
            filename = os.path.basename(self.path)
            file_path = os.path.join(SGF_DIR, filename)

            # Security check: ensure the file is actually inside SGF_DIR
            if os.path.commonpath([file_path, SGF_DIR]) == SGF_DIR and os.path.exists(file_path):
                self.send_response(200)
                self.send_header('Content-Type', 'application/x-go-sgf')
                self.send_header('Content-Disposition', f'attachment; filename="{filename}"')
                self.end_headers()
                with open(file_path, 'rb') as f:
                    self.wfile.write(f.read())
            else:
                self.send_error(404, "File not found")

        elif self.path.endswith(self.video_extensions + self.static_extensions):
            # Serve allowed static files normally (uses SimpleHTTPRequestHandler logic)
            super().do_GET()
            
        else:
            # Captive Portal: Redirect any other request (e.g. connectivity checks) to the gateway
            self.send_response(302)
            self.send_header('Location', f'http://{AP_GATEWAY_IP}/')
            self.end_headers()

    def do_POST(self) -> None:
        """Handles POST requests to save credentials or streaming config."""
        try:
            content_length = int(self.headers['Content-Length'])
            post_data = self.rfile.read(content_length).decode('utf-8')
            params = urllib.parse.parse_qs(post_data)

            action_list = params.get('action')
            action = action_list[0] if action_list else 'wifi' # Default to wifi for backward compatibility

            if action == 'stream':
                stream_url_list = params.get('stream_url')
                if stream_url_list:
                    self._save_stream_configuration(stream_url_list[0])
                    self._send_success_response("Streaming URL Updated", "The new stream URL has been saved.")
                else:
                    self.send_error(400, "Missing Stream URL.")

            elif action == 'wifi':
                ssid_list = params.get('ssid')
                password_list = params.get('password')

                if not ssid_list or not password_list:
                    self.send_error(400, "Missing SSID or Password fields.")
                    return

                self._save_wifi_configuration(ssid_list[0], password_list[0])
                self._send_success_response("Configuration Saved", "The device is rebooting to apply the new settings.")
                self._reboot_system()

            else:
                 self.send_error(400, f"Unknown action: {action}")

        except Exception as e:
            self.send_error(500, f"Internal Server Error: {str(e)}")

    def _save_stream_configuration(self, url: str) -> None:
        """Saves the RTMP URL to a file."""
        with open(STREAM_CONFIG_FILE, "w") as f:
            f.write(url)
        
        # Ensure the file is readable by the user (who runs the streaming script)
        try:
            os.chmod(STREAM_CONFIG_FILE, 0o644)
            # Match ownership with the video directory (owned by the user)
            stat_info = os.stat(VIDEO_DIR)
            os.chown(STREAM_CONFIG_FILE, stat_info.st_uid, stat_info.st_gid)
        except Exception as e:
            print(f"Warning: Could not set permissions/ownership on config file: {e}")

    def _save_wifi_configuration(self, ssid: str, password: str) -> None:
        """Writes the NetworkManager keyfile for the specified connection.
        
        Args:
            ssid: The Wi-Fi SSID.
            password: The Wi-Fi password.
            
        Raises:
            IOError: If writing the configuration file fails.
        """
        conn_uuid = str(uuid.uuid4())
        filename = f"/etc/NetworkManager/system-connections/{ssid}.nmconnection"
        
        config_content = f"""[connection]
id={ssid}
uuid={conn_uuid}
type=wifi
interface-name=wlan0

[wifi]
mode=infrastructure
ssid={ssid}

[wifi-security]
key-mgmt=wpa-psk
psk={password}

[ipv4]
method=auto

[ipv6]
method=auto
"""
        with open(filename, "w") as f:
            f.write(config_content)
        
        # NetworkManager requires strict permissions (600) for secrets.
        os.chmod(filename, 0o600)

    def _send_success_response(self, title: str, message: str) -> None:
        """Sends a success HTML page to the user."""
        self.send_response(200)
        self.send_header('Content-Type', 'text/html; charset=utf-8')
        self.end_headers()
        response_html = f"""
        <!DOCTYPE html>
        <html>
        <body style="font-family: sans-serif; padding: 40px; text-align: center;">
            <h1 style="color: green;">{title}</h1>
            <p>{message}</p>
            <p><a href="/">Return to Home</a></p>
        </body>
        </html>
        """
        self.wfile.write(response_html.encode('utf-8'))

    def _reboot_system(self) -> None:
        """Triggers a system reboot."""
        # Using subprocess.Popen allows the response to be sent before the script dies.
        subprocess.Popen(["reboot"])


def main() -> None:
    """Starts the TCP server."""
    # Ensure we serve files from the correct directory for SimpleHTTPRequestHandler
    if os.path.exists(VIDEO_DIR):
        os.chdir(VIDEO_DIR)
        
    with socketserver.TCPServer(("", PORT), WifiConfigHandler) as httpd:
        print(f"Starting Wi-Fi configuration server on port {PORT}...")
        print(f"Serving video files from: {VIDEO_DIR}")
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            print("\nShutting down server.")
            httpd.server_close()

if __name__ == "__main__":
    main()
